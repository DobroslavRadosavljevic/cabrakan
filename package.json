{
  "name": "sobek",
  "version": "0.0.1",
  "description": "Turn an OpenAPI document into a local MCP server.",
  "type": "module",
  "license": "MIT",
  "author": "Dobroslav Radosavljevic",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openapi",
    "swagger",
    "cli"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "bin": {
    "sobek": "./dist/cli.mjs"
  },
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./cli": {
      "types": "./dist/cli.d.mts",
      "import": "./dist/cli.mjs",
      "default": "./dist/cli.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "prepack": "bun run typecheck && bun run test && bun run build",
    "pack:dry": "npm pack --dry-run",
    "check:pack": "publint"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "effect": "^4.0.0-beta.107",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@effect/vitest": "^4.0.0-beta.107",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/bun": "^1.3.14",
    "publint": "^0.3.24",
    "tsdown": "^0.22.14",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs"
}
